          "cron": "30 13 * * *",
          "command": "preserve-battery"
        },
        {
          "id": "afternoon-preserve-retry",
          "name": "Retry afternoon preserve if battery became low",
          "cron": "0 14 * * *",
          "command": "preserve-battery"
        },
        {
          "id": "afternoon-preserve",
          "name": "Final preserve check before afternoon outage",
          "cron": "30 14 * * *",
          "command": "preserve-battery"
        },
        {
          "id": "afternoon-return-sbu",
          "name": "Return to SBU before afternoon outage",
          "cron": "25 15 * * *",
          "command": "return-sbu"
        },
        {
          "id": "afternoon-watchdog",
          "name": "Verify SBU after afternoon outage starts",
          "cron": "31 15 * * *",
          "command": "watchdog-sbu"
        }
      ]
    },
    "estate-16h": {
      "label": "16h weekday / 18h weekend",
