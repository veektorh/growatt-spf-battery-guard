      "outages": [
        {
          "days": "weekdays",
          "start": "08:00",
          "end": "10:30"
        },
        {
          "days": "weekdays",
          "start": "15:30",
          "end": "18:00"
        }
      ],
      "jobs": [
        {
          "id": "morning-preserve",
          "name": "Preserve battery before morning outage",
          "cron": "30 6 * * *",
          "command": "preserve-battery"
        },
        {
          "id": "morning-preserve-retry",
          "name": "Retry morning preserve if the first Utility switch failed",
          "cron": "40 6 * * *",
          "command": "preserve-battery"
        },
        {
          "id": "morning-return-sbu",
          "name": "Return to SBU before morning outage",
