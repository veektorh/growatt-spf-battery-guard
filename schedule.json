      "outages": [
        {
          "days": "weekdays",
          "start": "08:00",
          "end": "12:00"
        },
        {
          "days": "weekdays",
          "start": "14:00",
          "end": "18:00"
        },
        {
          "days": "weekends",
          "start": "08:00",
          "end": "11:00"
        },
        {
          "days": "weekends",
          "start": "15:00",
          "end": "18:00"
        }
      ],
      "jobs": [
        {
          "id": "morning-preserve-early",
          "name": "Estate-16h: earlier preserve before the 4h morning outage",
          "cron": "0 6 * * *",
          "command": "preserve-battery"
        },
        {
          "id": "morning-preserve",
          "name": "Preserve battery before the 08:00 outage",
          "cron": "30 6 * * *",
          "command": "preserve-battery"
        },
        {
          "id": "morning-preserve-retry",
          "name": "Retry morning preserve if the first Utility switch failed",
          "cron": "40 6 * * *",
          "command": "preserve-battery"
        },
        {
          "id": "morning-return-sbu",
          "name": "Return to SBU before the 08:00 outage",
          "cron": "55 7 * * *",
          "command": "return-sbu"
        },
        {
          "id": "morning-watchdog",
          "name": "Verify SBU after the 08:00 outage starts",
          "cron": "1 8 * * *",
          "command": "watchdog-sbu"
        },
        {
          "id": "afternoon-preserve-early",
          "name": "Weekday: begin preserving before the 14:00 outage",
          "cron": "0 13 * * 1-5",
          "command": "preserve-battery"
        },
        {
          "id": "afternoon-preserve-retry",
          "name": "Weekday: retry preserve if battery became low",
          "cron": "20 13 * * 1-5",
          "command": "preserve-battery"
        },
        {
          "id": "afternoon-preserve",
          "name": "Weekday: final preserve check before the 14:00 outage",
          "cron": "40 13 * * 1-5",
          "command": "preserve-battery"
        },
        {
          "id": "afternoon-return-sbu",
          "name": "Weekday: return to SBU before the 14:00 outage",
          "cron": "55 13 * * 1-5",
          "command": "return-sbu"
        },
        {
          "id": "afternoon-watchdog",
          "name": "Weekday: verify SBU after the 14:00 outage starts",
          "cron": "1 14 * * 1-5",
          "command": "watchdog-sbu"
